      "title": "Total Processed Parts Count",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "datasource": "PostgreSQL-JarvisTraceability",
          "rawSql": "SELECT COUNT(*) FROM process_result_records;",
          "format": "table"
        }
      ]
